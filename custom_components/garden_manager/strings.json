        "until": { "name": "Repeat until", "description": "Last date for the recurrence." }
      }
    },
    "complete_task": {
      "name": "Complete task",
      "description": "Marks a task as done, updates the planting and schedules the next occurrence of recurring tasks.",
      "fields": {
        "task_id": { "name": "Task", "description": "Task id." },
        "note": { "name": "Note", "description": "Optional note (e.g. harvest weight)." },
        "photos": { "name": "Photos", "description": "Image ids or URLs." },
        "skipped": { "name": "Skipped", "description": "Mark as skipped instead of done." }
      }
    },
    "postpone_task": {
      "name": "Postpone task",
      "description": "Moves a task; dependent tasks of the same planting move along.",
      "fields": {
        "task_id": { "name": "Task", "description": "Task id." },
        "days": { "name": "Days", "description": "Number of days to move (negative = earlier)." },
        "to_date": { "name": "New date", "description": "Explicit new due date." },
        "reason": { "name": "Reason", "description": "Stored as a note on the task." },
        "cascade": { "name": "Move dependants", "description": "Also move e.g. 'plant out' when 'sow' is postponed." }
      }
    },
    "delete_task": {
      "name": "Delete task",
      "description": "Deletes a user task; generated tasks are marked skipped.",
      "fields": { "task_id": { "name": "Task", "description": "Task id." } }
    },
    "generate_tasks": {
      "name": "Generate tasks",
      "description": "Regenerates tasks from the plan, plant database, sensors and forecast. Idempotent."
    },
    "recalculate_plan": {
      "name": "Recalculate plan",
      "description": "Refreshes the forecast and recalculates all windows, warnings and recommendations."
    },
    "export_plan": {
      "name": "Export plan",
      "description": "Returns the garden plan as a JSON-compatible response.",
      "fields": {
        "include_tasks": { "name": "Include tasks", "description": "Also export tasks." },
        "seasons": { "name": "Seasons", "description": "Only export plantings of these seasons." }
      }
