  "services": {
    "add_task": {
      "name": "Add task",
      "description": "Adds a garden task (optionally recurring).",
      "fields": {
        "title": { "name": "Title", "description": "What needs to be done." },
        "due_date": { "name": "Due date", "description": "Defaults to today." },
