        "description": { "name": "Description", "description": "Details or instructions." },
        "priority": { "name": "Priority", "description": "Low, normal, high or urgent." },
        "estimated_minutes": { "name": "Estimated duration", "description": "Minutes the task takes." },
        "bed": { "name": "Bed", "description": "Bed id or name." },
        "planting_id": { "name": "Planting", "description": "Link the task to a planting." },
